{
  "name": "zephyrex-vtt-client",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Zephyrex VTT client, built on the Zephyrex framework",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev -p 1109",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start -p 1109",
    "lint": "eslint .",
    "prettier": "prettier .",
    "prettier-fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "refresh:zephyrex": "pnpm update --no-save zephyrex @zephyrex/auth @zephyrex/lite @zephyrex/marketing @jgrieve/forms zod2gql",
    "pretest": "prisma generate",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook-build": "storybook build",
    "storybook-test": "test-storybook --url http://localhost:6006"
  },
  "dependencies": {
    "@jgrieve/forms": "^0.0.1-alpha.1",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@zephyrex/auth": "^0.0.1-alpha.1",
    "@zephyrex/lite": "^0.0.1-alpha.1",
    "@zephyrex/marketing": "^0.0.1-alpha.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zephyrex": "^0.0.1-alpha.1",
    "zod": "^4.6.5",
    "zod2gql": "^0.1.0-alpha.1"
  },
  "dependenciesMeta": {
    "zephyrex": {
      "injected": true
    },
    "@zephyrex/auth": {
      "injected": true
    },
    "@jgrieve/forms": {
      "injected": true
    },
    "zod2gql": {
      "injected": true
    },
    "@zephyrex/lite": {
      "injected": true
    },
    "@zephyrex/marketing": {
      "injected": true
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/test-runner": "^0.24.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.2"
  }
}
