# The framework commits a Zephyrex VTT build uses, each from its public GitHub repository.
# Zephyrex VTT's path dependencies expect the checkouts beside the repository
# (server/pyproject.toml and client/pnpm-workspace.yaml reach them at ../../<name>).
# Bump a ref, and a deploy builds against it. A ref must be on GitHub before a deploy can
# fetch it. WIKI_REF pins zephyrex-rpg-wiki the same way (the server loads its extensions).
SERVER_FRAMEWORK_REF=797a0cc606cd476a6315f048b411f410e04a24a4
CLIENT_FRAMEWORK_REF=10d409fb05b94dd46780268b03c15e45ad532712
AUTH_REF=b8749a302e748dea1e4c4c6a286c7199ce9879a1
DYNAMIC_FORM_REF=95ad4daa4fc93105e754601323d2cd5a601a8061
ZOD2GQL_REF=2309c5984e7ace7a5ce9414cab5b158bcc881625
WIKI_REF=13ceb8292614a150c2c80689a54583db971a85d0
